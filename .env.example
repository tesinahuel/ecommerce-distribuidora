# Copiá este archivo a .env.local para desarrollar en tu compu. En Vercel se cargan en Settings → Environment Variables.
# NUNCA subas .env.local a GitHub.

# Base de datos (Postgres). En Vercel la carga sola al conectar Storage → Neon.
DATABASE_URL=postgresql://usuario:clave@host:5432/base

# Contraseña del panel /admin (elegí una larga). Sin esto el panel queda cerrado.
ADMIN_PASSWORD=
# Opcional: clave para firmar la sesión del panel (si no se define, se usa ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=

# Aviso de pedidos nuevos por WhatsApp (Green API)
OWNER_WHATSAPP_NUMBER=5491124545608
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Aviso de pedidos nuevos por email (Resend)
RESEND_API_KEY=
OWNER_EMAIL=
# RESEND_FROM_EMAIL="Huevos Cósmicos <onboarding@resend.dev>"
